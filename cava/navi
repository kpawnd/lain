[general]
framerate = 40
autosens = 1
bars = 48
lower_cutoff_freq = 40
higher_cutoff_freq = 12000

[input]
method = pulse
source = auto

[output]
method = raw
channels = mono
mono_option = average
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 70
