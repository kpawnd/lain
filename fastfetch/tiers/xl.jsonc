{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "color": {
      "1": "38;2;200;228;242",
      "2": "38;2;46;70;98",
      "3": "38;2;124;179;207",
      "4": "38;2;74;122;160"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;92;154;196",
      "title": "38;2;142;192;224",
      "output": "38;2;212;213;221"
    },
    "key": {},
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;92;154;196",
        "yellow": "38;2;164;180;203",
        "red": "38;2;201;79;93"
      }
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "color": {
        "elapsed": "38;2;92;154;196",
        "total": "38;2;38;58;81"
      },
      "border": {
        "left": "",
        "right": " "
      }
    }
  },
  "modules": [
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "title",
      "format": "{#1;38;2;212;213;221}{user-name}{#0;38;2;56;84;117}@{#0;38;2;92;154;196}navi.wired"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────",
      "outputColor": "38;2;38;58;81"
    },
    {
      "type": "os",
      "key": "  os     ",
      "format": "{name} {arch}"
    },
    {
      "type": "kernel",
      "key": "  kernel ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "  wm     ",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "  term   ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "  shell  ",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "cpu",
      "key": "  cpu    ",
      "format": "{name} · {cores-logical}t"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu    ",
      "format": "{name}",
      "hideType": "none"
    },
    {
      "type": "memory",
      "key": "󰍛  mem    ",
      "format": "{percentage-bar} {used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊  disk   ",
      "folders": "/",
      "format": "{size-percentage-bar} {size-used} / {size-total}"
    },
    {
      "type": "battery",
      "key": "󰁹  bat    ",
      "format": "{capacity} · {status}"
    },
    {
      "type": "packages",
      "key": "󰏗  pkgs   ",
      "format": "{pacman} pacman"
    },
    {
      "type": "uptime",
      "key": "  up     "
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────",
      "outputColor": "38;2;38;58;81"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": "present day, present time.",
      "outputColor": "38;2;56;84;117"
    }
  ]
}
